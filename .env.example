# Local development
NODE_ENV=development
PORT=5000

# Use the Sentinel Supabase PostgreSQL connection string here.
# Do not commit the real password or DATABASE_URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# At least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
DB_POOL_MAX=10
HORUS_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-secret

# Product-to-Sentinel signed integration
SENTINEL_INTEGRATION_SECRET=replace-with-a-long-random-integration-secret
SENTINEL_TENANT_ID=sentinel-integration
