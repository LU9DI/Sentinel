# Local development
NODE_ENV=development
PORT=5000

# REQUIRED: replace every placeholder below with real local secrets.
# Get the PostgreSQL URI from the Sentinel Supabase project: Supabase -> Connect -> PostgreSQL.
# Do not commit the real password or DATABASE_URL.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SUPABASE_PASSWORD@REPLACE_WITH_SUPABASE_HOST:5432/postgres

# At least 32 random characters. Example generation in PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
DB_POOL_MAX=10
HORUS_BOOTSTRAP_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Product-to-Sentinel signed integration
SENTINEL_INTEGRATION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
SENTINEL_TENANT_ID=sentinel-integration
